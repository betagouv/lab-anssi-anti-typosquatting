{
  "name": "typosquatting-detector",
  "version": "1.0.0",
  "description": "Extension navigateur de détection des sites frauduleux utilisant du typosquatting",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:firefox": "TARGET_BROWSER=firefox vite dev",
    "build": "vite build",
    "build:firefox": "TARGET_BROWSER=firefox vite build",
    "build:all": "npm run build && npm run build:firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:ext": "npm run build:firefox && web-ext lint --source-dir=dist/firefox --self-hosted",
    "genere:domaines": "node scripts/genere-les-domaines-legitimes.ts",
    "test:complet": "VERIFICATION_COMPLETE=1 vitest run",
    "classifieur:generer": "node classifieur/ligne-de-commande/commande.ts generer",
    "classifieur:repartir": "node classifieur/ligne-de-commande/commande.ts repartir",
    "classifieur:normaliser": "node classifieur/ligne-de-commande/commande.ts normaliser",
    "classifieur:entrainer": "node classifieur/ligne-de-commande/commande.ts entrainer",
    "classifieur:evaluer": "node classifieur/ligne-de-commande/commande.ts evaluer",
    "classifieur:predire": "node classifieur/ligne-de-commande/commande.ts predire",
    "classifieur:chaine": "node classifieur/ligne-de-commande/commande.ts chaine",
    "classifieur:essai": "node classifieur/ligne-de-commande/commande.ts essai",
    "classifieur:reentrainer": "node classifieur/ligne-de-commande/commande.ts reentrainer",
    "classifieur:verifier-chaine": "node classifieur/verification/verifier-chaine.ts",
    "classifieur:exporter-modele": "node classifieur/exportation/exporter-modele.ts",
    "classifieur:verifier-export": "node classifieur/exportation/exporter-modele.ts verifier"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/webextension-polyfill": "0.12.6",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-web-extension": "4.5.1",
    "vitest": "5.1.1",
    "web-ext": "10.8.0"
  },
  "dependencies": {
    "@tensorflow/tfjs": "4.22.0",
    "punycode.js": "2.3.1",
    "tldts": "7.5.4",
    "webextension-polyfill": "0.12.0"
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "web-ext-run": {
      "firefox-profile": "4.7.1",
      "fx-runner": "1.7.0",
      "tmp": "0.2.7",
      "node-notifier": {
        "uuid": "11.1.1"
      }
    }
  }
}
