{
  "manifest_version": 2,
  "name": "Détection de Typosquatting",
  "version": "1.0",
  "description": "Détecte et avertis à propos des typosquatting avant de charger un site web.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "thibaud.marazano@beta.gouv.fr"
    }
  },
  "background": {
    "scripts": ["dist/background.js"],
    "type": "module",
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "dragon.svg"
  },
  "icons": {
    "48": "dragon.svg"
  }
}
